# ===== LLM 配置（OpenAI 兼容接口） =====
# 支持 OpenAI / 通义千问 DashScope / DeepSeek / 本地 Ollama 等任意兼容 /v1/chat/completions 的服务。
# 通义千问示例：base_url=https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
# DeepSeek 示例：base_url=https://api.deepseek.com/v1                model=deepseek-chat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# ===== 运行模式 =====
# 1 = 演示模式（无需 API Key，内置 Mock 走通 Agent 全流程）
# 0 = 调用真实 LLM（需正确填写上面的 KEY 与 BASE_URL）
# 若不填且未设置 API Key，将自动进入演示模式。
MOCK_MODE=1

# ===== Web 服务端口 =====
WEB_PORT=8000
